# ═════════════════════════════════════════════════════════════
# AI Runtime OS — 后端环境配置示例
#
# 用法：cp .env.example .env   然后按需修改
#
# ⚠️ 两个容易踩的坑：
#   1. 本文件由 app/config.py 的 env_file=".env" 读取，路径相对「进程工作目录」，
#      所以必须在 backend/ 目录下启动 uvicorn，否则读不到这份配置。
#   2. DEBUG=true 时应用启动会执行 Base.metadata.create_all() 自动建表。
#      首次运行务必保持 true；改成 false 后不会再自动建表（不会删表，但新表也不会建）。
# ═════════════════════════════════════════════════════════════

# ── 应用 ────────────────────────────────────────────────────
APP_NAME=AI Runtime OS
DEBUG=true
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5176,http://localhost:5173,http://127.0.0.1:5176

# ── 数据库 ──────────────────────────────────────────────────
# 开发默认 SQLite，零依赖，文件落在 backend/ai_runtime.db
DATABASE_URL=sqlite+aiosqlite:///./ai_runtime.db
# 生产切 PostgreSQL（先 cd backend && docker compose up -d postgres）：
# DATABASE_URL=postgresql+asyncpg://admin:aios_dev_2026@localhost:5432/ai_runtime_os

# Redis 可选：不配也能跑，EventBus 自动退化为内存实现
REDIS_URL=redis://localhost:6379/0

# ── LLM ────────────────────────────────────────────────────
# 支持任意 OpenAI 兼容服务：DeepSeek / 官方 OpenAI / vLLM / one-api / Ollama
#   DeepSeek   → https://api.deepseek.com/v1     模型 deepseek-chat
#   OpenAI     → https://api.openai.com/v1       模型 gpt-4o-mini
#   本地 Ollama→ http://localhost:11434/v1       模型 qwen2.5-coder:7b
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=deepseek-chat

# 本地 Ollama 兜底地址（没装可忽略）
OLLAMA_BASE_URL=http://localhost:11434

# 走 Anthropic Claude 时才需要（可选）
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# 没有可用 key 时也能验证链路：把模型写成 mock:任意名，
# 例如 DEFAULT_LLM_MODEL=mock:test —— 会返回固定假数据，不产生费用。

# ── 认证 / JWT ─────────────────────────────────────────────
# 生产必须换！生成方式：
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-key-please-replace-with-64-hex-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30
