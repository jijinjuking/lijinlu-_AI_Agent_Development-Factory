# 数据库 — 默认用 SQLite 免 Docker 开发
# 切换到 PostgreSQL：DATABASE_URL=postgresql+asyncpg://admin:aios_dev_2026@localhost:5432/ai_runtime_os
DATABASE_URL=sqlite+aiosqlite:///./ai_runtime.db

# Redis — Phase 1 可选，无 Redis 时用内存 Event Bus
REDIS_URL=redis://localhost:6379/0

# 应用
APP_NAME=AI Runtime OS
DEBUG=true
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5175,http://localhost:5173,tauri://localhost
